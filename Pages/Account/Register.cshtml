@page
@model ForoAttritionErrorWeb.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-title">Create account</div>

        <form method="post" class="auth-form">
            <div class="field">
                <label asp-for="Input.UserName" class="label"></label>
                <input asp-for="Input.UserName" class="input" autocomplete="name" />
                <span asp-validation-for="Input.UserName" class="error-text"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Mail" class="label"></label>
                <input asp-for="Input.Mail" class="input" autocomplete="email" />
                <span asp-validation-for="Input.Mail" class="error-text"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Password" class="label"></label>
                <input asp-for="Input.Password" class="input" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="error-text"></span>
            </div>

            <div class="field">
                <label asp-for="Input.ConfirmPassword" class="label"></label>
                <input asp-for="Input.ConfirmPassword" class="input" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="error-text"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Register</button>

            <div class="auth-links">
                <a asp-page="/Account/Login">Back to login</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
            }
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
